{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Euclide",
  "version": "0.3.0",
  "identifier": "fr.elliotmoreau.euclide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/seed-linuxdeploy-gtk.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Euclide",
        "width": 1080,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: eufile: http://eufile.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost eufile: http://eufile.localhost",
        "media-src": "'self' blob: eufile: http://eufile.localhost",
        "frame-src": "'none'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/euclide-sidecar"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNTIyRkI1QTk5MzA2MDUKUldRRkJwT3B0UzlTeXBCUWpnbTNHSkZSd3MxbHJHemlNVUkxRmUwaUU4ZjdscGxESmtDRkNxdVAK",
      "endpoints": [
        "https://github.com/cempack/euclide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
