{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Euclide",
  "version": "0.1.0",
  "identifier": "fr.elliotmoreau.euclide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "true",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Euclide",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "**/Euclide-Data/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/euclide-sidecar"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
