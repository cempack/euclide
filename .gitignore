# dependencies
node_modules/

# frontend build
dist/

# rust / tauri build
src-tauri/target/
src-tauri/gen/schemas/

# portable data created at runtime (lives on the USB, never in git)
**/Euclide-Data/

# python sidecar build artifacts
sidecar/build/
sidecar/dist/
sidecar/.venv/
__pycache__/
*.pyc

# do not commit platform-specific sidecar binaries / onedir bundles (built in CI per platform, copied to resources during build)
src-tauri/resources/euclide-sidecar.exe
src-tauri/resources/euclide-sidecar/*
# Placeholder so a fresh clone builds (tauri-build needs bundle.resources to exist).
!src-tauri/resources/euclide-sidecar/.gitkeep

# os / editor
.DS_Store
*.log
.vscode/
.idea/

# screenshot harness (reference images are per machine)
.shots/
test-results/
playwright-report/
